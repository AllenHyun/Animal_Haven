// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           Int           @id @default(autoincrement())
  firstName    String
  lastName     String
  email        String        @unique
  password     String
  postcode     Int
  description  String?       @db.Text
  bookings     Booking[]
  applications Application[]
  createdAt    DateTime      @default(now())
}

model Booking {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  date      DateTime @default(now())
  timeFrame String
  location  Shelter  @relation(fields: [shelterId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])
  userId    Int?
  shelterId Int
}

model AvailableTime {
  id          Int      @id @default(autoincrement())
  timeFrame   String
  date        DateTime
  shelter     Shelter  @relation(fields: [shelterId], references: [id])
  shelterId   Int
  isAvailable Boolean  @default(true)
}

enum ApplicationType {
  FOSTER
  ADOPTION
}

enum ApplicationStatus {
  DRAFT
  STARTED
  PROCESSING_DOCUMENTATION
  IN_PROGRESS
  IN_REVISION
  APPROVED
  REJECTED
}

model Application {
  id        Int               @id @default(autoincrement())
  type      ApplicationType   @default(ADOPTION)
  status    ApplicationStatus @default(STARTED)
  user      User?             @relation(fields: [userId], references: [id])
  userId    Int?
  firstName String
  lastName  String
  address   String
  notes     String            @db.Text
  pet       Pet               @relation(fields: [petId], references: [id])
  petId     Int
  location  Shelter           @relation(fields: [shelterId], references: [id])
  shelterId Int               @default(1)
}

model Shelter {
  id             Int             @id @default(autoincrement())
  name           String
  address        String
  postcode       Int
  pets           Pet[]
  bookings       Booking[]
  availableTimes AvailableTime[]
  applications   Application[]
}

enum Gender {
  Male
  Female
}

enum Animal {
  Cat
  Dog
}

model Pet {
  id           Int           @id @default(autoincrement())
  name         String
  breed        String?
  age          Int
  gender       Gender
  animalType   Animal
  profileImg   String
  description  String        @default("Description")
  shelter      Shelter?      @relation(fields: [shelterId], references: [id])
  shelterId    Int?
  applications Application[]
}
